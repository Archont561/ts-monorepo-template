{
  "name": "@myorg/example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "pages": {
    "dir": "public"
  },
  "scripts": {
    "dev": "mbun --hot src/index.ts",
    "build": "munocss build",
