{
  "name": "@myorg/example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mbun --hot src/index.ts",
    "start": "mbun src/index.ts",
    "typecheck": "mtsc --noEmit",
    "test": "mbun test tests/",
    "coverage": "mbun test tests/ --coverage",
    "test:e2e": "me2e",
    "build:css": "bunx unocss --out-file public/uno.css || echo 'UnoCSS not enabled or build failed'"
  },
  "dependencies": {
    "@myorg/external": "workspace:*"
  },
  "devDependencies": {
    "@myorg/ts": "workspace:*",
    "@myorg/playwright": "workspace:*",
    "@myorg/unocss": "workspace:*",
    "@myorg/native": "workspace:*"
  }
}
