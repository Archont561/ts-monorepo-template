    "test:e2e": "me2e",
    "build:css": "munocss build",
    "build:css:watch": "munocss watch"
  },
  "dependencies": {
    "@myorg/external": "workspace:*"
  },
  "devDependencies": {
    "@myorg/ts": "workspace:*",
    "@myorg/playwright": "workspace:*",
    "@myorg/unocss": "workspace:*",
    "@myorg/native": "workspace:*",
    "@playwright/test": "^1.63.0"
  }
}
