# Root .dockerignore - monorepo wide
# Prevents sending unnecessary files to Docker build context
# Speeds up builds and avoids accidentally including secrets

node_modules
dist
.turbo
*.tsbuildinfo
*.log
*.log.*
.env
.env.*
!.env.example
coverage
.DS_Store
Thumbs.db

# Playwright
test-results
playwright-report
blob-report

# Lefthook
lefthook-local.yml

# act
.actrc.local
.secrets

# AI agent skills
.agents/*
!.agents/skills/
!.agents/skills/**
!.agents/skills.index.json
!.agents/README.md

# Rust / Cargo
/target/
target/
**/target/
# Cargo.lock is ignored for library (cdylib) per guide, but we keep it in context for cache if present
# Comment out if you want to include it:
# Cargo.lock

# NAPI generated
**/*.node
**/*.wasi.cjs
**/wasi-worker.mjs
# A stray npm dir at the repo root — NOT packages/native/npm, which is source.
/npm/
# Generated loaders, binaries and per-platform packages (one npm dir per binding)
packages/native/npm/*/index.js
packages/native/npm/*/index.d.ts
packages/native/npm/*/*.node
packages/native/npm/*/*.wasm
packages/native/npm/*-*/

# Git
.git
.gitignore

# OS
.DS_Store
Thumbs.db

# IDE
.vscode
.idea
*.swp
*.swo

# UnoCSS generated
**/uno.css
apps/example/public/uno.css

# Docker
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml
.docker

# Turbo cache
.turbo

# Used for both root and apps/example (context is root)
