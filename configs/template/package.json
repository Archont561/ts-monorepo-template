{
  "name": "@myorg/template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scaffold": {
    "default": "always",
    "selfDestruct": true,
    "scriptsToRemove": [
      "docs:sync",
      "docs:site",
      "docs:dev",
      "docs:build",
      "docs:preview"
    ],
    "removals": {
      "always": {
        "extraRemovals": [
          ".github/workflows/template-docs.yml",
          "apps/template-docs"
        ],
        "filePatternsToRemove": [
          "**/template-docs.yml",
          "**/template-docs/**",
          ".changeset/*.md"
        ],
        "fileRegexesToRemove": [
          "template-docs"
        ]
      }
    }
  },
  "bin": {
    "mdocs": "./src/docs.ts"
  },
  "scripts": {
    "build": "mbun build ./src/index.ts --outdir ./dist --target bun --packages bundle --minify",
    "test": "mbun test",
    "coverage": "mbun test --coverage --coverage-reporter lcov",
    "typecheck": "mtsc --noEmit"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.0",
    "@myorg/manifest": "workspace:*",
    "@myorg/pages": "workspace:*",
    "@myorg/ts": "workspace:*"
  },
  "dependencies": {
    "citty": "^0.2.2"
  }
}
