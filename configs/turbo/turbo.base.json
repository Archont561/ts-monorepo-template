{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "public/uno.css"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "build:native": {
      "dependsOn": ["^build"],
      "outputs": ["*.node", "index.js", "index.d.ts"],
      "cache": false
    },
    "build:wasm": {
      "dependsOn": ["build:native"],
      "outputs": ["*.wasi.cjs", "wasi-worker.mjs"],
      "cache": false
    }
  }
}
