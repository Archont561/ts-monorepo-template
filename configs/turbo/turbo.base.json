{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "build:native": {
      "dependsOn": ["^build"],
      "outputs": ["*.node", "index.js", "index.d.ts"],
      "cache": false
    },
    "build:wasm": {
      "dependsOn": ["build:native"],
      "outputs": ["*.wasi.cjs", "wasi-worker.mjs"],
      "cache": false
    },
    "cargo:check": {
      "cache": false
    },
    "cargo:clippy": {
      "cache": false
    },
    "cargo:fmt": {
      "cache": false
    },
    "cargo:fmt:check": {
      "cache": false
    },
    "cargo:test": {
      "cache": false
    },
    "cargo:build": {
      "outputs": ["target/**"],
      "cache": false
    },
    "cargo:build:release": {
      "outputs": ["target/**"],
      "cache": false
    },
    "cargo:build:ci": {
      "outputs": ["target/**"],
      "cache": false
    }
  }
}
