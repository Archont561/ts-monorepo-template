{
  "name": "@myorg/native-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scaffold": {
    "default": "none",
    "flag": "native",
    "prompt": "Set up native Node-API (NAPI-RS) bindings?",
    "type": "select",
    "options": [
      {
        "value": "none",
        "label": "None - skip native bindings"
      },
      {
        "value": "publish",
        "label": "Publish a native npm package"
      },
      {
        "value": "docker",
        "label": "Build native bindings in Docker"
      }
    ],
    "removals": {
      "none": {
        "extraRemovals": [
          "packages/native",
          "rust-toolchain.toml",
          ".cargo",
          "apps/example/src/pages/api/native"
        ],
        "filePatternsToRemove": [
          "**/*.node",
          "**/*.napi.*",
          "**/*.wasi.cjs",
          "rust-toolchain.toml",
          ".cargo/**",
          "**/native/**",
          "**/api/native/**"
        ],
        "fileRegexesToRemove": [
          "\\\\.node$",
          "napi",
          "rust-toolchain",
          "api/native"
        ],
        "appDepsToRemove": [
          "@myorg/native"
        ]
      },
      "publish": {},
      "docker": {}
    },
    "setup": "configs/native/src/setup.ts"
  },
  "exports": {
    ".": "./index.ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.9.1"
  }
}
