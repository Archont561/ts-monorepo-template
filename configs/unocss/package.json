{
  "name": "@myorg/unocss",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scaffold": {
    "default": false,
    "flag": "unocss",
    "prompt": "Include UnoCSS (atomic CSS engine)?",
    "type": "confirm",
    "removals": {
      "true": {},
      "false": {
        "extraRemovals": [
          "apps/example/public/index-unocss.html",
          "apps/example/public/uno.css",
          "apps/example/uno.config.ts"
        ],
        "filePatternsToRemove": [
          "**/index-unocss.html",
          "**/uno.css",
          "**/*.unocss.*"
        ],
        "fileRegexesToRemove": [
          "index-unocss"
        ],
        "appDepsToRemove": [
          "@unocss/reset",
          "unocss",
          "@myorg/unocss"
        ]
      }
    },
    "setup": "configs/unocss/src/setup.ts"
  },
  "exports": {
    ".": "./index.ts"
  },
  "devDependencies": {
    "unocss": "^66.10.2"
  }
}
