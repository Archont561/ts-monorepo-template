{
  "name": "my-library",
  "packageManager": "bun@1.4.2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "configs/*"
  ],
  "devDependencies": {
    "@myorg/biome": "workspace:*",
    "@myorg/bun-config": "workspace:*",
    "@myorg/bunup": "workspace:*",
    "@myorg/changeset": "workspace:*",
    "@myorg/citty": "workspace:*",
    "@myorg/devcontainer": "workspace:*",
    "@myorg/gh-actions": "workspace:*",
    "@myorg/lefthook": "workspace:*",
    "@myorg/native-config": "workspace:*",
    "@myorg/native": "workspace:*",
    "@myorg/pages": "workspace:*",
    "@myorg/playwright": "workspace:*",
    "@myorg/skills": "workspace:*",
    "@myorg/template": "workspace:*",
    "@myorg/ts": "workspace:*",
    "@myorg/turbo": "workspace:*",
    "@myorg/unocss": "workspace:*"
  },
  "bun-create": {
    "preinstall": "bun configs/template/dist/index.js",
    "start": "bun run dev"
  },
  "scripts": {
    "preinstall": "node -e \"if(!process.env.npm_config_user_agent?.includes('bun')){console.error('\\\\n❌ This project requires Bun. Run: bun install\\\\n');process.exit(1)}\"",
    "prepare": "msetup lefthook && mchangeset init",
    "build": "mturbo build",
    "build:css": "bunx unocss --config configs/unocss/uno.config.ts || echo 'UnoCSS not enabled'",
    "build:native": "bun --filter @myorg/native run build",
    "build:wasm": "bun --filter @myorg/native run build:wasm",
    "test:native": "bun --filter @myorg/native run test",
    "cargo:check": "cargo check --workspace || echo 'cargo not found, skipping'",
    "cargo:clippy": "cargo clippy --workspace -- -D warnings || echo 'cargo not found'",
    "cargo:fmt": "cargo fmt --all || echo 'cargo not found'",
    "cargo:fmt:check": "cargo fmt --all -- --check || echo 'cargo not found'",
    "cargo:test": "cargo test --workspace || echo 'cargo not found'",
    "cargo:build": "cargo build --workspace || echo 'cargo not found'",
    "cargo:build:release": "cargo build --workspace --release || echo 'cargo not found'",
    "cargo:build:ci": "cargo build --workspace --profile ci || echo 'cargo not found'",
    "dev": "mturbo dev",
    "typecheck": "mturbo typecheck",
    "docs:sync": "mdocs",
    "test": "mturbo test",
    "test:e2e": "mturbo test:e2e",
    "coverage": "mbun coverage",
    "check": "mbiome check",
    "check:fix": "mbiome check --write",
    "ci:lint": "mci lint",
    "ci:list": "mci act -l",
    "ci:dry": "mci act push -n",
    "ci:local": "mci act push",
    "skills:sync": "mskills sync",
    "skills:list": "mskills list",
    "skills:add": "mskills add",
    "skills:update": "mskills update",
    "skills:validate": "mskills validate",
    "skills:index": "mskills index",
    "clean:modules": "find . -name 'node_modules' -not -path '*/node_modules/*' -prune -exec rm -rf {} +",
    "reinstall": "mbun run clean:modules && mbun install",
    "changeset": "mchangeset",
    "version": "mchangeset version",
    "release": "mchangeset publish"
  }
}
