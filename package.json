{
  "name": "my-library",
  "packageManager": "bun@1.4.2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/native/npm/*",
    "packages/native/crates"
  ],
  "devDependencies": {
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2",
    "@myorg/native": "workspace:*",
    "@myorg/tooling": "workspace:*",
    "emnapi": "1.11.2"
  },
  "bun-create": {
    "preinstall": "bun packages/tooling/dist/scaffold/run.js",
    "start": "bun run dev"
  },
  "scripts": {
    "build": "m turbo build",
    "build:native": "m native napi:build",
    "build:wasm": "m native napi:build:wasm",
    "changeset": "m changeset",
    "check": "m lint",
    "check:fix": "m lint:fix",
    "ci:dry": "m ci act push -n",
    "ci:lint": "m ci:lint",
    "ci:list": "m ci act -l",
    "ci:local": "m ci act push",
    "clean:modules": "m bun clean:modules",
    "coverage": "m turbo coverage && m coverage merge",
    "coverage:check": "m coverage check",
    "coverage:html": "m coverage html",
    "coverage:merge": "m coverage merge",
    "coverage:report": "bun run coverage && bun run coverage:html",
    "coverage:summary": "m coverage summary",
    "dev": "m turbo dev",
    "docs:build": "m turbo build --filter=@myorg/template-docs",
    "docs:dev": "m turbo dev --filter=@myorg/template-docs",
    "docs:preview": "m turbo preview --filter=@myorg/template-docs",
    "docs:site": "m docs site",
    "docs:sync": "m docs && m coverage sync",
    "preinstall": "node -e \"if(!process.env.npm_config_user_agent?.includes('bun')){console.error('\\\\n\u274c This project requires Bun. Run: bun install\\\\n');process.exit(1)}\"",
    "prepare": "m setup lefthook && m changeset init && m coverage sync",
    "reinstall": "bun run clean:modules && bun install",
    "release": "m changeset publish",
    "security:audit": "m native audit || echo 'cargo audit not installed (cargo install cargo-audit)'",
    "security:check": "bun run security:gitleaks; bun run security:trivy || true",
    "security:gitleaks": "m gitleaks detect",
    "security:trivy": "m trivy fs . --severity HIGH,CRITICAL",
    "skills": "m skills",
    "test": "m turbo test",
    "test:e2e": "m turbo test:e2e",
    "test:native": "m native test",
    "test:template": "m turbo test --filter=@myorg/tooling",
    "test:template:cases": "m turbo test --filter=@myorg/tooling -- tests/scaffold/cases.test.ts",
    "test:template:coverage": "m turbo coverage --filter=@myorg/tooling",
    "test:template:watch": "m turbo watch test --filter=@myorg/tooling",
    "typecheck": "m turbo typecheck",
    "version": "m changeset version"
  }
}
