{
  "name": "my-library",
  "packageManager": "bun@1.4.2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "configs/*",
    "packages/native/npm/*",
    "packages/native/crates"
  ],
  "devDependencies": {
    "@myorg/badges": "workspace:*",
    "@myorg/biome": "workspace:*",
    "@myorg/bun-config": "workspace:*",
    "@myorg/bunup": "workspace:*",
    "@myorg/changeset": "workspace:*",
    "@myorg/citty": "workspace:*",
    "@myorg/codeql": "workspace:*",
    "@myorg/community": "workspace:*",
    "@myorg/coverage": "workspace:*",
    "@myorg/dependabot": "workspace:*",
    "@myorg/devcontainer": "workspace:*",
    "@myorg/editorconfig": "workspace:*",
    "@myorg/gh-actions": "workspace:*",
    "@myorg/gitattributes": "workspace:*",
    "@myorg/gitleaks": "workspace:*",
    "@myorg/lefthook": "workspace:*",
    "@myorg/native": "workspace:*",
    "@myorg/native-config": "workspace:*",
    "@myorg/pages": "workspace:*",
    "@myorg/playwright": "workspace:*",
    "@myorg/skills": "workspace:*",
    "@myorg/stale": "workspace:*",
    "@myorg/template": "workspace:*",
    "@myorg/trivy": "workspace:*",
    "@myorg/ts": "workspace:*",
    "@myorg/turbo": "workspace:*",
    "@myorg/unocss": "workspace:*"
  },
  "bun-create": {
    "preinstall": "bun configs/template/dist/index.js",
    "start": "bun run dev"
  },
  "scripts": {
    "build": "mturbo build",
    "build:native": "mnative napi:build",
    "build:wasm": "mnative napi:build:wasm",
    "changeset": "mchangeset",
    "check": "mbiome check",
    "check:fix": "mbiome check --write",
    "ci:dry": "mci act push -n",
    "ci:lint": "mci lint",
    "ci:list": "mci act -l",
    "ci:local": "mci act push",
    "clean:modules": "mbun clean:modules",
    "coverage": "mturbo coverage && mcoverage merge",
    "coverage:check": "mcoverage check",
    "coverage:html": "mcoverage html",
    "coverage:merge": "mcoverage merge",
    "coverage:report": "bun run coverage && bun run coverage:html",
    "coverage:summary": "mcoverage summary",
    "dev": "mturbo dev",
    "docs:build": "mturbo build --filter=@myorg/template-docs",
    "docs:dev": "mturbo dev --filter=@myorg/template-docs",
    "docs:preview": "mturbo preview --filter=@myorg/template-docs",
    "docs:site": "mdocs site",
    "docs:sync": "mdocs && mcoverage sync",
    "preinstall": "node -e \"if(!process.env.npm_config_user_agent?.includes('bun')){console.error('\\\\n\u274c This project requires Bun. Run: bun install\\\\n');process.exit(1)}\"",
    "prepare": "msetup lefthook && mchangeset init && mcoverage sync",
    "reinstall": "bun run clean:modules && bun install",
    "release": "mchangeset publish",
    "security:audit": "mnative audit || echo 'cargo audit not installed (cargo install cargo-audit)'",
    "security:check": "bun run security:gitleaks; bun run security:trivy || true",
    "security:gitleaks": "mgitleaks detect",
    "security:trivy": "mtrivy fs . --severity HIGH,CRITICAL",
    "skills": "mskills",
    "test": "mturbo test",
    "test:e2e": "mturbo test:e2e",
    "test:native": "mnative test",
    "test:template": "mturbo test --filter=@myorg/template",
    "test:template:cases": "mturbo test --filter=@myorg/template -- tests/cases.test.ts",
    "test:template:coverage": "mturbo coverage --filter=@myorg/template",
    "test:template:watch": "mturbo watch test --filter=@myorg/template",
    "typecheck": "mturbo typecheck",
    "version": "mchangeset version"
  }
}
