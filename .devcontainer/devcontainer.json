{
  "name": "my-bun-monorepo",
  "image": "mcr.microsoft.com/devcontainers/base:1.2.1-ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22.13.1",
      "installYarnUsingApt": false
    },
    "ghcr.io/devcontainers/features/bun:1": {
      "version": "1.3.11"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "stable",
      "profile": "default"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "2.74.2"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "2.12.0",
      "dockerDashComposeVersion": "v2.24.5"
    }
  },
  "postCreateCommand": {
    "bun-install": "bun install",
    "rust-targets": "rustup target add wasm32-wasip1-threads || echo 'rustup target add failed, continuing'",
    "lefthook": "bunx lefthook install || echo 'lefthook install skipped'"
  },
  "postStartCommand": "echo '✅ Dev container ready — bun $(bun --version), node $(node --version), rustc $(rustc --version 2>/dev/null || echo not-found)'",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Example app",
      "onAutoForward": "notify"
    }
  },
  "remoteUser": "vscode",
  "remoteEnv": {
    "BUN_INSTALL": "/home/vscode/.bun"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "oven.bun-vscode",
        "biomejs.biome",
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "ms-vscode.vscode-json",
        "GitHub.copilot",
        "GitHub.vscode-pull-request-github"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "biomejs.biome",
        "editor.codeActionsOnSave": {
          "source.organizeImports.biome": "explicit",
          "source.fixAll.biome": "explicit"
        },
        "files.associations": {
          "bun.lock": "json",
          "bunfig.toml": "toml"
        },
        "rust-analyzer.check.command": "clippy"
      }
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "shutdownAction": "none"
}
