**/coverage/lcov.info.tmp

.DS_Store
Thumbs.db

# Playwright
test-results/
playwright-report/
blob-report/
test-results
playwright-report
blob-report

# Lefthook (developer-local overrides, never committed)
lefthook-local.yml

# act (local CI simulation)
.actrc.local

# act secrets (never commit)
.secrets

# AI agent skills — vendored via skills.sh + curated
# .agents/ is the skills.sh ecosystem folder:
# - .agents/skills/ — vendored skills (committed for reproducibility)
# - .agents/skills.index.json — generated index (committed)
# Other .agents/* (e.g. Claude, Cursor) may be local and are ignored
.agents/*
!.agents/skills/
!.agents/skills/**
!.agents/skills.index.json
!.agents/README.md

# Rust / Cargo
# Workspace target dir (shared across members) — always ignored
/target/
target/
**/target/
# Cargo.lock — commit for binaries, ignore for libraries (native is cdylib lib)
Cargo.lock
# NAPI-RS generated
**/*.node
**/*.wasi.cjs
**/wasi-worker.mjs
npm/
# Keep root Cargo.toml workspace, ignore generated JS loader in packages/native when built
packages/native/index.js
packages/native/index.d.ts
packages/native/*.node
# Generic JS loader (if generated at root)
index.js
index.d.ts

# UnoCSS generated
**/uno.css
apps/example/public/uno.css

# VitePress (template-only docs site)
docs/.vitepress/dist/
docs/.vitepress/cache/
# Coverage HTML rendered into the docs site by `mdocs site` (served at /coverage/)
docs/public/coverage/
# Pages staging dir — assembled by `mpages build` from declared packages
.pages/
