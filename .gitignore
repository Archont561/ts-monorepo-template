node_modules/
dist/
*.tsbuildinfo
.turbo/
.turbo/**
apps/*/.turbo/
packages/*/.turbo/
*.log
*.log.*
.env
.env.*
!.env.example
coverage/
# `coverage/` above has no leading slash, so it matches a directory named
# "coverage" at ANY depth — including source directories that must ship.
# Anything tracked whose path contains such a directory needs a negation here
# (and a scaffolded project needs its own). Prefer not naming source
# directories "coverage": packages/tooling/src/ci/fragments/coverage-report/
# is spelled that way for exactly this reason.
# The scaffold bundle under packages/tooling/dist/ is committed on purpose:
# bun-create.preinstall runs it before node_modules exists, so it cannot be
# built on the consumer's machine. `dist/` above would otherwise hide it.
!packages/tooling/dist/
!packages/tooling/dist/**
# Bun coverage temp files
**/coverage/.lcov.info.*.tmp
**/coverage/lcov.info.tmp

.DS_Store
Thumbs.db

# Playwright
test-results/
playwright-report/
blob-report/
test-results
playwright-report
blob-report

# Lefthook (developer-local overrides, never committed)
lefthook-local.yml

# act (local CI simulation)
.actrc.local

# act secrets (never commit)
.secrets

# AI agent skills — vendored via skills.sh + curated
# .agents/ is the skills.sh ecosystem folder:
# - .agents/skills/ — vendored skills (committed for reproducibility)
# - .agents/skills.index.json — generated index (committed)
# Other .agents/* (e.g. Claude, Cursor) may be local and are ignored
.agents/*
!.agents/skills/
!.agents/skills/**
!.agents/skills.index.json
!.agents/README.md

# Rust / Cargo
# Workspace target dir (shared across members) — always ignored
/target/
target/
**/target/
# Cargo.lock — commit for binaries, ignore for libraries (native is cdylib lib)
Cargo.lock
# NAPI-RS generated
**/*.node
**/*.wasi.cjs
**/wasi-worker.mjs
# A stray npm dir at the repo root — NOT packages/native/npm, which is source.
/npm/
# Generated napi loaders/binaries are ignored per package in
# packages/native/.gitignore (npm/*/index.js, npm/*/*.node, npm/*-*/, ...)
# Generic JS loader (if generated at root)
index.js
index.d.ts

# UnoCSS generated
**/uno.css
apps/example/public/uno.css

# Pages staging dir — assembled by `mpages build` from declared packages
.pages/
