{
  "name": "@myorg/native",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "native.wasi.cjs",
    "native.wasi-browser.js",
    "native.wasm"
  ],
  "napi": {
    "binaryName": "native",
    "packageName": "@myorg/native",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "wasm32-wasip1-threads"
    ],
    "wasm": {
      "initialMemory": 16,
      "maximumMemory": 65536,
      "browser": {
        "fs": false,
        "asyncInit": true,
        "errorEvent": true
      }
    }
  },
  "scripts": {
    "build": "m native napi:build --only native",
    "build:debug": "m native napi:build:debug --only native",
    "build:wasm": "m native napi:build:wasm --only native",
    "create-npm-dirs": "m native create-npm-dirs --only native",
    "artifacts": "m native artifacts --only native",
    "test": "m bun test",
    "test:watch": "m bun test --watch",
    "typecheck": "m typecheck --noEmit",
    "cargo:check": "m native check",
    "cargo:clippy": "m native clippy",
    "cargo:fmt": "m native fmt",
    "cargo:fmt:check": "m native fmt:check",
    "cargo:test": "m native test",
    "cargo:tree": "m native tree",
    "cargo:update": "m native update",
    "cargo:doc": "m native doc",
    "cargo:audit": "m native audit"
  },
  "devDependencies": {
    "@myorg/native-crates": "workspace:*",
    "@myorg/tooling": "workspace:*",
    "@napi-rs/cli": "^3.9.1"
  }
}
